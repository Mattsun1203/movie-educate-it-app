# ブログ記事・カテゴリーを管理するmicroCMSサービスのドメイン（https://{ドメイン}.microcms.io）
MICROCMS_SERVICE_DOMAIN=

# microCMSのAPIキー（サーバーサイドのみで使用するためNEXT_PUBLIC_プレフィックスは付けない）
MICROCMS_API_KEY=

# back（Hono API）のベースURL。未設定時は"http://localhost:3000"にフォールバックする（front/src/lib/api/client.ts）。
# クライアントサイドからも参照するためNEXT_PUBLIC_プレフィックスを付ける。
NEXT_PUBLIC_API_BASE_URL=
