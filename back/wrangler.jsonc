{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codestep-back",
  "main": "src/app.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // `wrangler hyperdrive create <name> --connection-string="<Neon mainブランチの接続文字列>"` の出力idに置き換える
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      // ダミーのプレースホルダー。DBに触れないローカルテスト（pnpm test）が
      // 追加設定なしで起動できるようにするための既定値で、実際に接続はしない。
      // ローカル開発（wrangler dev）やCIでは.dev.vars／環境変数の
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVEがこれより優先される。
      "localConnectionString": "postgresql://placeholder:placeholder@localhost:5432/placeholder"
    }
  ],
  "env": {
    // developブランチへのpushで自動デプロイされるステージング環境。
    // nameを省略しwranglerの既定命名（codestep-back-develop）に任せる。
    // hyperdriveはenv間で継承されないため個別に指定する必要がある。
    "develop": {
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // `wrangler hyperdrive create <name> --connection-string="<Neon developブランチの接続文字列>"` の出力idに置き換える
          "id": "REPLACE_WITH_HYPERDRIVE_ID_DEVELOP"
        }
      ]
    }
  }
}
